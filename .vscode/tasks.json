{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gradle: run",
            "type": "shell",
            "command": ".\\gradlew run 2>&1",
            "isBackground": true,
            "problemMatcher": {
                "owner": "gradle",
                "fileLocation": "relative",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Task :run",
                    "endsPattern": "Listening for transport dt_socket at address: 5005"
                }
            }
        }
    ]
}
